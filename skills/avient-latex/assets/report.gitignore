# ZIP fallback (or legacy ignored clone), including branding and examples.
/.avient-latex/
# Upstream archives retained by a browser/manual ZIP download.
/avient-latex-class*.zip
# Do NOT ignore /avient-latex-class/ or .gitmodules: track the submodule link.
# Legacy flattened installation (do not replace existing authored files).
/avient.cls
/brand/
# Existing root-level copy of the upstream logo.
/avient-logo.pdf

# All generated artifacts, including PDFs, belong in these directories.
/build/
/out/

